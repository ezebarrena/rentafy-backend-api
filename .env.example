# Dos bases de datos PostgreSQL separadas, tal como especifica el capítulo 4 de la tesis
# ("Bases de datos: PostgreSQL"): una financiera (catálogo, cotizaciones, scoring) y una
# no financiera (usuarios, perfiles, favoritos). Ver README, sección "Dos bases de datos".
DATABASE_URL_FINANCIERA=postgresql+psycopg2://postgres:postgres@localhost:5432/rentafy_financiera
DATABASE_URL_NO_FINANCIERA=postgresql+psycopg2://postgres:postgres@localhost:5432/rentafy_no_financiera

# Secreto para firmar los JWT de sesión (RNF-15). Generar uno propio en producción, por
# ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173
