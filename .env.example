# URL de la base de datos. SQLite para desarrollo local; en producción (ver capítulo 4 de la
# tesis, sección "Bases de datos: PostgreSQL") se reemplaza por una URL de PostgreSQL, por
# ejemplo: postgresql+psycopg2://usuario:password@host:5432/rentafy
DATABASE_URL=sqlite:///./rentafy.db

# Secreto para firmar los JWT de sesión (RNF-15). Generar uno propio en producción, por
# ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173
