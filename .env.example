# Dos bases de datos PostgreSQL separadas, tal como especifica el capítulo 4 de la tesis
# ("Bases de datos: PostgreSQL"): una financiera (catálogo, cotizaciones, scoring) y una
# no financiera (usuarios, perfiles, favoritos). Ver README, sección "Dos bases de datos".
DATABASE_URL_FINANCIERA=postgresql+psycopg2://postgres:postgres@localhost:5432/rentafy_financiera
DATABASE_URL_NO_FINANCIERA=postgresql+psycopg2://postgres:postgres@localhost:5432/rentafy_no_financiera

# Secreto para firmar los JWT de sesión (RNF-15). Generar uno propio en producción, por
# ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173

# Client ID de OAuth de Google Cloud Console (el mismo que VITE_GOOGLE_CLIENT_ID del frontend)
# — se usa para validar que el ID token que manda el frontend fue emitido para esta app.
GOOGLE_CLIENT_ID=

# Emails con rol admin (separados por coma). Habilitan las pantallas de testeo interno (Debug
# Score y Auditoría del Score) y sus endpoints. Vacío = nadie es admin.
ADMIN_EMAILS=

# Envío de mails (verificación de cuenta y recuperación de contraseña). SMTP genérico: con Gmail alcanza (creá una cuenta,
# activá la verificación en dos pasos y generá una "contraseña de aplicación"); más adelante se puede pasar a Amazon SES
# cambiando solo estas variables. Sin SMTP_HOST no se envía nada: el mail y su código quedan escritos en el log del
# backend (útil para desarrollar). La contraseña va SOLO acá, en el .env del servidor: no se comparte ni se sube al repo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Dirección que ven los usuarios como remitente (por defecto, SMTP_USER) y el nombre que se muestra.
EMAIL_REMITENTE=
EMAIL_REMITENTE_NOMBRE=Rentafy
# Dirección pública de la app (se usa en los links de los mails).
APP_URL=https://rentafy-app.com.ar
